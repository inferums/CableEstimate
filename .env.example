# Пароль синхронизации: без него /api/sync отвечает «не настроено».
# Задаётся в настройках проекта на Vercel (Settings → Environment Variables),
# а не в файле: файл с паролем в репозиторий не попадает.
CABLE_SYNC_PASSWORD=

# Токен приватного хранилища Blob. На Vercel подставляется сам, когда
# хранилище подключено к проекту; нужен только для локального запуска
# через `vercel dev`.
BLOB_READ_WRITE_TOKEN=
